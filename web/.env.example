# Where the web app's server reaches the FastAPI backend (never exposed to the browser).
ERP_API_URL=http://localhost:8010/api/v1
# Cookies are Secure (HTTPS only) in production builds; set false only to test a production build over plain HTTP.
COOKIE_SECURE=true
# Cloudflare Turnstile site key for the vendor sign-up form, read when the app runs; empty = no robot check.
# Cloudflare's always-pass test key: 1x00000000000000000000AA
TURNSTILE_SITE_KEY=
