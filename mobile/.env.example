# Copy to mobile/.env (git-ignored). Restart `npx expo start` after changing it.
# Backend API base URL:
#   Android emulator: http://10.0.2.2:<port>/api/v1   (10.0.2.2 = your computer)
#   Real phone:       http://<computer's LAN IP>:<port>/api/v1   (same Wi-Fi; allow the port in the firewall)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1
