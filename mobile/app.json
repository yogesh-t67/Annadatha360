{
  "expo": {
    "name": "Annadata 360",
    "slug": "annadata-360",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.annadata360.app"
    },
    "android": {
      "package": "com.annadata360.app",
      "adaptiveIcon": {
        "backgroundColor": "#1F7A3F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Annadata 360 uses the camera to photograph crop problems.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Annadata 360 uses the microphone so you can ask farming questions by speaking.",
          "speechRecognitionPermission": "Annadata 360 turns your spoken question into text to answer it.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ]
  }
}
