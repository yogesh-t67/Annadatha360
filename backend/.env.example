# Copy to .env and adjust.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://annadata:annadata@localhost:5432/annadata
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=60
# "console" logs OTPs to stdout (dev only) | "msg91" (needs DLT — see docs/development/external-dependencies.md)
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS_PER_HOUR=5
# Closed beta (non-production only): these numbers log in with OTP_TEST_CODE (6 digits), no SMS sent.
OTP_TEST_NUMBERS=[]
OTP_TEST_CODE=
CORS_ORIGINS=["*"]

# Weather (Open-Meteo). Free tier needs no key; set both for the commercial plan.
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_API_KEY=
WEATHER_CACHE_TTL_SECONDS=1800

# Mandi prices (data.gov.in / Agmarknet). Free key from data.gov.in. Used by: python -m app.jobs.sync_market_prices
DATA_GOV_IN_API_KEY=

# AI (Claude). Without a key, AI endpoints return 503 ai_not_configured.
# AI_PROVIDER=fake gives canned, clearly-labelled replies without a key (non-production only).
# AI_PROVIDER=gemini: free Google Gemini for TESTING ONLY (key from https://aistudio.google.com/apikey).
# Free-tier data may be used by Google to improve its products: test questions/photos only, never real farmers' data.
AI_PROVIDER=anthropic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_CHAT_EFFORT=low
AI_DIAGNOSIS_EFFORT=medium
# Monthly spend cap in USD (UTC month). Placeholder for the dev sandbox — raise before launch.
AI_MONTHLY_BUDGET_USD=50
AI_CALL_RESERVE_USD=0.20
AI_FARMER_DAILY_REQUEST_LIMIT=30
AI_CHAT_HISTORY_MESSAGES=20

# Payments. "fake" = dev, no money moves (use POST /orders/{id}/payment/dev-complete). "razorpay" for real.
PAYMENT_PROVIDER=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ORDER_PAYMENT_WINDOW_MINUTES=30
# Cash on delivery
COD_ENABLED=false
COD_MAX_ORDER_RUPEES=5000

# ERP (vendor portal + admin). FIELD_ENCRYPTION_KEY is required in production; empty = derived from JWT_SECRET (dev).
FIELD_ENCRYPTION_KEY=
ERP_WEB_BASE_URL=http://localhost:3000
ERP_ACCESS_TOKEN_TTL_MINUTES=10
ERP_SESSION_IDLE_MINUTES=30
ERP_SESSION_MAX_HOURS=12
ERP_INVITE_TTL_HOURS=72
ERP_PASSWORD_RESET_TTL_MINUTES=30
ERP_PASSWORD_RESET_MAX_PER_HOUR=3
ERP_LOGIN_MAX_FAILURES=5
ERP_LOGIN_LOCK_MINUTES=15
ERP_LOGIN_MAX_ATTEMPTS_PER_IP=30
EMAIL_PROVIDER=console

# Private documents (KYC). Local = encrypted files on disk; S3 comes with the AWS setup.
DOCUMENT_STORAGE=local
DOCUMENTS_DIR=storage/documents
DOCUMENT_MAX_MB=10
DOCUMENT_DAILY_UPLOAD_LIMIT=50
DOCUMENT_LINK_TTL_SECONDS=300

# Vendor catalog. Listings go live at once unless CATALOG_REQUIRES_APPROVAL=true.
CATALOG_REQUIRES_APPROVAL=false
MEDIA_DIR=storage/media
MEDIA_MAX_MB=5

# Vendor checks. IFSC and pincode lookups are free public services. KYC_PROVIDER=manual: the Super Admin checks
# GSTIN / PAN / bank by hand; a paid provider (GST, PAN, penny drop) plugs in here later.
KYC_PROVIDER=manual
IFSC_LOOKUP_URL=https://ifsc.razorpay.com
PINCODE_LOOKUP_URL=https://api.postalpincode.in
LOOKUP_TIMEOUT_SECONDS=5
