# Copy to .env and adjust.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://annadata:annadata@localhost:5432/annadata
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=60
# "console" logs OTPs to stdout (dev only) | "msg91" (needs DLT — see docs/development/external-dependencies.md)
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS_PER_HOUR=5
CORS_ORIGINS=["*"]

# Weather (Open-Meteo). Free tier needs no key; set both for the commercial plan.
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_API_KEY=
WEATHER_CACHE_TTL_SECONDS=1800
